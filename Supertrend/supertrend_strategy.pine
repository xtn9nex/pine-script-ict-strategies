//@version=6
// ============================================================================
//  Supertrend — Strategy (pullback-to-line entry, trailing-stop exit)
// ----------------------------------------------------------------------------
//  Plots the Supertrend trailing line (direction coloring, fills, flip markers)
//  and trades pullbacks to the line:
//
//    ENTRY : in the trend direction, when price comes within `proximityPts` of
//            (or touches) the line but CLOSES back on the trend side.
//    STOP  : trails `stopBufferPts` beyond the line (below for longs, above for
//            shorts) for the whole trade, ratcheting. Trailing-stop-only exit;
//            no take-profit.
//    RULES : one trade at a time; NEVER enter during a trend transition (no
//            entries within `minBarsSinceFlip` bars of a flip); re-entry allowed
//            after a stop-out while the trend persists, capped at
//            `maxTradesPerTrend` entries per trend segment (resets on a flip).
//
//  Trend state is available as:
//      direction : -1 = uptrend (line below price)   +1 = downtrend (above)
//      flipUp / flipDn : trend-flip bars
//      supertrend: the active trailing-line value
//
//  Supertrend is built from three ingredients:
//    1) a source (default hl2),
//    2) ATR (length + smoothing method) for volatility,
//    3) a multiplier (factor) for band distance.
//  The bands "ratchet" (only tighten in the trend's favor) and the line flips
//  when price closes through the opposing band.
//
//  NOTE on repainting: the current (unclosed) bar can flip intrabar. Any future
//  entry/exit logic should act on confirmed/closed bars (e.g. barstate.isconfirmed
//  or [1]-offset) to keep the backtest honest.
// ============================================================================

strategy("Supertrend Strategy", overlay = true, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, calc_on_order_fills = false, process_orders_on_close = true, max_labels_count = 500)

// ----------------------------------------------------------------------------
//  Inputs
// ----------------------------------------------------------------------------
grpST = "Supertrend"
srcIn   = input.source(hl2, "Source", group = grpST)
atrLen  = input.int(10, "ATR length", minval = 1, group = grpST)
factor  = input.float(3.0, "Multiplier (factor)", minval = 0.1, step = 0.1, group = grpST)
atrMeth = input.string("RMA (Wilder)", "ATR smoothing", options = ["RMA (Wilder)", "SMA", "EMA", "WMA"], group = grpST)

grpTrade = "Entry / Exit"
proximityPts  = input.float(1.0, "Entry proximity to line (points)", minval = 0.0, step = 0.25, group = grpTrade, tooltip = "Enter when price comes within this many points of the Supertrend line (or touches it) but closes back on the trend side.")
stopBufferPts = input.float(1.0, "Stop buffer from line (points)", minval = 0.0, step = 0.25, group = grpTrade, tooltip = "The trailing stop always sits this many points beyond the Supertrend line (below it for longs, above it for shorts), maintained for the whole trade.")
allowLong  = input.bool(true, "Allow longs",  group = grpTrade)
allowShort = input.bool(true, "Allow shorts", group = grpTrade)
maxTradesPerTrend = input.int(2, "Max trades per trend segment", minval = 1, group = grpTrade, tooltip = "Cap the number of entries during a single Supertrend trend (resets when the trend flips). Reduces churn during choppy/consolidation periods.")
minBarsSinceFlip  = input.int(1, "Min bars after a flip before entering", minval = 0, group = grpTrade, tooltip = "Never enter during the trend transition: no entry within this many bars of a Supertrend flip. 1 = exclude the flip bar itself; increase to keep entries further from the transition.")
orderQty   = input.float(1.0, "Order size (contracts/shares/lots)", minval = 0.000001, group = grpTrade)

grpStyle = "Style"
upColor   = input.color(#26a69a, "Uptrend",   group = grpStyle)
downColor = input.color(#ef5350, "Downtrend", group = grpStyle)
lineWidth = input.int(2, "Line width", minval = 1, group = grpStyle)
showFill  = input.bool(true, "Shade fill toward price", group = grpStyle)
showFlips = input.bool(true, "Show flip markers", group = grpStyle)
stopColor = input.color(color.orange, "Trailing stop", group = grpStyle)

// ----------------------------------------------------------------------------
//  ATR (smoothing method selectable; RMA = classic Wilder / TradingView default)
// ----------------------------------------------------------------------------
float tr  = ta.tr(true)
float atr = switch atrMeth
    "SMA" => ta.sma(tr, atrLen)
    "EMA" => ta.ema(tr, atrLen)
    "WMA" => ta.wma(tr, atrLen)
    => ta.rma(tr, atrLen)

// ----------------------------------------------------------------------------
//  Supertrend calculation (canonical: ratcheting bands + close-through flip)
// ----------------------------------------------------------------------------
float upperBand = srcIn + factor * atr
float lowerBand = srcIn - factor * atr
float prevUpper = nz(upperBand[1], upperBand)
float prevLower = nz(lowerBand[1], lowerBand)

// bands only move in the trend's favor (ratchet), unless price closed through
lowerBand := lowerBand > prevLower or close[1] < prevLower ? lowerBand : prevLower
upperBand := upperBand < prevUpper or close[1] > prevUpper ? upperBand : prevUpper

int   direction  = na
float supertrend = na
float prevST = supertrend[1]
if na(atr[1])
    direction := 1
else if prevST == prevUpper
    direction := close > upperBand ? -1 : 1
else
    direction := close < lowerBand ? 1 : -1
supertrend := direction == -1 ? lowerBand : upperBand

// trend flips (exposed for the eventual entry/exit logic)
bool flipUp = direction == -1 and direction[1] == 1
bool flipDn = direction ==  1 and direction[1] == -1

// ----------------------------------------------------------------------------
//  Visualization
// ----------------------------------------------------------------------------
// draw the active band, broken on flips so the two colors don't connect
float upSeg = direction == -1 ? supertrend : na
float dnSeg = direction ==  1 ? supertrend : na
pUp = plot(upSeg, "Uptrend line",   color = upColor,   style = plot.style_linebr, linewidth = lineWidth)
pDn = plot(dnSeg, "Downtrend line", color = downColor, style = plot.style_linebr, linewidth = lineWidth)

// shaded fill between the trailing line and price
pClose = plot(showFill ? close : na, "", display = display.none)
fill(pUp, pClose, color.new(upColor, 90),   title = "Uptrend fill")
fill(pDn, pClose, color.new(downColor, 90), title = "Downtrend fill")

// flip markers
plotshape(showFlips and flipUp, "Flip up",   style = shape.triangleup,   location = location.belowbar, color = upColor,   size = size.tiny)
plotshape(showFlips and flipDn, "Flip down", style = shape.triangledown, location = location.abovebar, color = downColor, size = size.tiny)

alertcondition(flipUp, "Supertrend flip up",   "Supertrend flipped to UP")
alertcondition(flipDn, "Supertrend flip down", "Supertrend flipped to DOWN")

// ----------------------------------------------------------------------------
//  Entry / Exit
//    Entry : price comes within `proximityPts` of (or touches) the line but
//            CLOSES back on the trend side -> enter in the trend direction.
//    Stop  : always sits `stopBufferPts` beyond the line (below for longs,
//            above for shorts) and trails with it (ratcheting; frozen if the
//            trend flips so the stop is never yanked to the opposite band).
//            Trailing-stop only.
//    One trade at a time; re-entry allowed after a stop-out while the trend
//    persists, up to `maxTradesPerTrend` per trend segment (resets on a flip).
//    No take-profit.
// ----------------------------------------------------------------------------
var float trailStop = na

// entries taken in the current trend segment + bars since the last flip; both
// reset whenever the trend flips
var int tradesThisTrend = 0
var int barsSinceFlip    = 0
if direction != direction[1]
    tradesThisTrend := 0
    barsSinceFlip   := 0
else
    barsSinceFlip   := barsSinceFlip + 1

bool longSetup  = allowLong  and direction == -1 and low  <= supertrend + proximityPts and close > supertrend
bool shortSetup = allowShort and direction ==  1 and high >= supertrend - proximityPts and close < supertrend

// never enter during the trend transition (the flip bar / its neighborhood)
bool trendEstablished = barsSinceFlip >= minBarsSinceFlip

if strategy.position_size == 0 and trendEstablished and tradesThisTrend < maxTradesPerTrend
    // flat, past the transition & under the per-trend cap -> look for an entry
    if longSetup
        strategy.entry("Long", strategy.long, qty = orderQty)
        trailStop := supertrend - stopBufferPts
        strategy.exit("Long stop", from_entry = "Long", stop = trailStop)
        tradesThisTrend += 1
    else if shortSetup
        strategy.entry("Short", strategy.short, qty = orderQty)
        trailStop := supertrend + stopBufferPts
        strategy.exit("Short stop", from_entry = "Short", stop = trailStop)
        tradesThisTrend += 1
else if strategy.position_size > 0
    // long: trail at line - buffer while the uptrend holds (keeps the buffer)
    if direction == -1
        trailStop := math.max(trailStop, supertrend - stopBufferPts)
    strategy.exit("Long stop", from_entry = "Long", stop = trailStop)
else
    // short: trail at line + buffer while the downtrend holds
    if direction == 1
        trailStop := math.min(trailStop, supertrend + stopBufferPts)
    strategy.exit("Short stop", from_entry = "Short", stop = trailStop)

// show the live trailing stop while in a trade
plot(strategy.position_size != 0 ? trailStop : na, "Trailing stop", color = stopColor, style = plot.style_linebr, linewidth = 1)
